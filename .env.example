# =============================================================================
# Real-Time Interview Assistant — server environment
# Copy this file to `.env` in the repository root and fill in real keys.
# The server loads this file automatically. NEVER commit `.env`.
# =============================================================================

# Required — get free keys (see README section 9)
DEEPGRAM_API_KEY=your_deepgram_api_key_here
GROQ_API_KEY=your_groq_api_key_here

# Required server settings
PORT=5000
CLIENT_URL=http://localhost:5173

# -----------------------------------------------------------------------------
# Optional tuning (defaults shown). Change only if you know why.
# -----------------------------------------------------------------------------
DEEPGRAM_MODEL=nova-3
DEEPGRAM_LANGUAGE=en-US
DEEPGRAM_ENDPOINTING_MS=300
DEEPGRAM_UTTERANCE_END_MS=1000
DEEPGRAM_CONNECT_TIMEOUT_MS=10000

GROQ_MODEL=openai/gpt-oss-120b
GROQ_MAX_TOKENS=700
GROQ_TEMPERATURE=0.3
GROQ_TIMEOUT_MS=30000

# Question detection
QUESTION_SILENCE_MS=900
QUESTION_MIN_WORDS=4
QUESTION_MIN_FOLLOWUP_WORDS=1
DUPLICATE_WINDOW_MS=30000
DUPLICATE_SIMILARITY=0.82

# debug | info | warn | error
LOG_LEVEL=info
